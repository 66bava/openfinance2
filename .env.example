# Copie este arquivo para .env.local e preencha com seus valores reais
# NUNCA commite o .env.local no git

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# IA (Conselheiro no dashboard / análises)
# Importante: a chamada à IA foi movida para `/api/ai` (Vercel Function) para não expor a chave no browser.
# Configure as variáveis abaixo no ambiente do servidor (Vercel) ou no seu `.env.local` quando usar `vercel dev`.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
GROQ_API_KEY=gsk_...
# Opcional: modelo da Groq (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback (opcional) - Gemini API (Google AI Studio)
# Se a Groq falhar com 401 e essa chave existir, o backend usa Gemini automaticamente.
GEMINI_API_KEY=AIza...
# Opcional: modelo do Gemini (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
